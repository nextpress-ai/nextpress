#!/usr/bin/env bash
set -euo pipefail

readonly CLI_VERSION="nextpress 1.6.0"
readonly DEFAULT_INSTALL_DIR="/opt/nextpress"
readonly DEFAULT_VERSION="latest"
readonly COMPOSE_FILE="docker-compose.prod.yml"
readonly RELEASE_CONFIG_FILE="nextpress.config.json"
readonly BACKUP_DIR="backups"
readonly DEFAULT_COMPOSE_SPEC_URL="https://raw.githubusercontent.com/nextpress-ai/nextpress/main/docker-compose.prod.yml"
readonly DEFAULT_COMMAND_URL="${NEXTPRESS_COMMAND_URL:-${NEXTPRESS_RAW_BASE:-https://raw.githubusercontent.com/nextpress-ai/nextpress/main}/scripts/nextpress}"
readonly MIN_FREE_MB_INSTALL=1024
readonly MIN_FREE_MB_DOCKER=2048
readonly BACKUP_KEEP_COUNT=3
readonly SETUP_URL="http://nextpress.localhost"
readonly TRANSFER_RUNNER="dist/transfer-cli.js"
readonly RESET_PASSWORD_RUNNER="dist/reset-password-cli.js"
# Updates from the admin dashboard (see "Updates from the admin dashboard" below).
readonly UPDATE_DIR_NAME="update"
readonly UPDATE_LOG_DIR_NAME="update-logs"
# Same as CORE_UPDATE_PROTOCOL in shared/core-update/types.ts.
readonly UPDATE_PROTOCOL=1
# Same as CORE_UPDATE_TIMING.requestMaxAgeMs in shared/core-update/derive-status.ts.
readonly UPDATE_REQUEST_MAX_AGE_SECONDS=300
readonly UPDATE_REQUEST_MAX_BYTES=4096
readonly UPDATE_LOG_KEEP_COUNT=10
readonly UPDATE_HELPER_OFF_FILE=".update-helper-off"
readonly UPGRADE_LOCK_FILE=".upgrade.lock"
readonly RELEASE_LATEST_API_URL="https://api.github.com/repos/nextpress-ai/nextpress/releases/latest"

INSTALL_DIR="${NEXTPRESS_INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
INSTALL_VERSION="$DEFAULT_VERSION"
UPGRADE_OVERRIDE="false"
UPGRADE_YES="false"
POSITIONALS=()

info() {
	printf '%s\n' "$*"
}

warn() {
	printf '%s\n' "Warning: $*" >&2
}

fail() {
	printf '%s\n' "Error: $*" >&2
	exit 1
}

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

docker_accessible() {
	docker info >/dev/null 2>&1
}

sudo_docker_accessible() {
	command_exists sudo && sudo docker info >/dev/null 2>&1
}

print_help() {
	cat <<EOF
nextpress - self-host and manage a NextPress server

Install NextPress:
  curl -fsSL https://raw.githubusercontent.com/nextpress-ai/nextpress/main/install.sh | bash

Options:
  -d, --install-dir <path>   Install location (default: $DEFAULT_INSTALL_DIR)
  --version <tag>            Install a specific NextPress version.

Commands:
  install                    Install and start NextPress.
  upgrade                    Upgrade NextPress to the latest available image.
  upgrade --latest           Explicitly upgrade to the latest image.
  upgrade --version <tag>    Upgrade to a specific NextPress version.
  upgrade --override         Reset incompatible database state after backup.
  upgrade --override --yes   Run override mode without a confirmation prompt.
  reload                     Reload the web router.
  restart                    Restart NextPress services.
  status                     Show service status.
  logs [service...]          Follow service logs.
  export                     Export site data to a file.
  import <file>              Import data from an export file.
  reset [--yes]              Reset the instance to a fresh install (backs up first).
  reset-password <login>     Set a new password for a locked-out account.
  update-helper on|off|status
                             Turn updates from the admin dashboard on or off.
  uninstall --yes            Stop services and remove this install.
  version, -v, --version     Print command version.

Export:
  nextpress export [--users] [--sites] [--pages] [--blogs] [--posts]
                   [--comments] [--media] [--templates] [--options]
                   [--site <name>] [--with-media-files] [--out <path>] [--force]

  Writes nextpress-export-YYYYMMDD-HHMMSS.json in the current directory
  (.tar.gz when --with-media-files is given). No entity flags export
  everything. --site <name> limits the export to one site (site name or
  hostname). --out <path> picks the output file; existing files are refused
  unless --force is given.

Import:
  nextpress import <file> [--users] [--sites] [--pages] [--blogs] [--posts]
                   [--comments] [--media] [--templates] [--options]
                   [--mode overwrite|skip]

  Restores data from an export file. No entity flags import everything.
  --mode overwrite (default) refreshes existing rows; --mode skip leaves
  existing rows untouched.

Reset:
  nextpress reset [--yes]

  Erases all data and uploaded media, then re-applies migrations and seeds
  default content — leaving the instance in a fresh-install state. A database
  backup is written to backups/ automatically. Use --yes to skip the prompt.
  Typical flow: nextpress export --out ~/data.json, then nextpress reset,
  then nextpress import ~/data.json.

Reset password:
  nextpress reset-password <email or username> [--password-stdin]

  Asks for the new password twice without showing it, saves it and signs
  that person out everywhere. Sites stay up. Nothing else changes.
  --password-stdin reads the password from a pipe instead, for scripts.

Entities: users, sites, pages, blogs, posts, comments, media, templates, options

Updates from the admin dashboard:
  nextpress update-helper on|off|status

  Install and upgrade turn this on when the server runs systemd and the
  command runs as root. The dashboard then offers "Update now" to the main
  site's admins: it backs up the database, installs the newest official
  release, and goes back to the running version if anything fails.
  off removes the background service; updates then work only from here.

Examples:
  nextpress install
  nextpress install --version beta-v1.0.2
  nextpress install --install-dir "\$HOME/nextpress"
  nextpress upgrade
  nextpress upgrade --version beta-v1.0.2
  nextpress upgrade --override --yes
  nextpress export
  nextpress export --users --posts --site example.com
  nextpress export --with-media-files --out ~/nextpress-export.tar.gz
  nextpress import nextpress-export-20260827-120000.json
  nextpress import nextpress-export.tar.gz --mode skip
  nextpress reset-password you@example.com
  nextpress logs
EOF
}

parse_global_args() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-d|--install-dir)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 <path>."
				fi
				INSTALL_DIR="$2"
				shift 2
				;;
			*)
				POSITIONALS+=("$1")
				shift
				;;
		esac
	done
}

resolve_install_dir() {
	local raw="$1"
	local resolved

	raw="${raw%"${raw##*[![:space:]]}"}"
	raw="${raw#"${raw%%[![:space:]]*}"}"

	if [ "$raw" = "" ]; then
		fail "Refusing to use an empty install directory."
	fi

	case "$raw" in
		/*) resolved="$raw" ;;
		*) resolved="$(pwd)/$raw" ;;
	esac

	while [ "${#resolved}" -gt 1 ] && [[ "$resolved" == */ ]]; do
		resolved="${resolved%/}"
	done

	if [ "$resolved" = "/" ]; then
		fail "Refusing to use root as the install directory."
	fi

	INSTALL_DIR="$resolved"
}

assert_docker_available() {
	if docker_accessible && docker compose version >/dev/null 2>&1; then
		return
	fi

	if sudo_docker_accessible && sudo docker compose version >/dev/null 2>&1; then
		return
	fi

	fail "Docker Compose v2 not found. Install Docker Engine + Compose plugin, then run this command again."
}

assert_install_dir_exists() {
	if [ ! -d "$INSTALL_DIR" ]; then
		fail "Install directory not found: $INSTALL_DIR. Install first: nextpress install"
	fi
}

assert_install_dir_writable() {
	local caddy_dir="$INSTALL_DIR/caddy_config"
	local file

	if [ ! -w "$INSTALL_DIR" ]; then
		fail "Install directory is not writable: $INSTALL_DIR. Re-run with sudo or choose a writable --install-dir."
	fi

	for file in "$INSTALL_DIR/$COMPOSE_FILE" "$INSTALL_DIR/.env" "$caddy_dir/Caddyfile"; do
		if [ -e "$file" ] && [ ! -w "$file" ]; then
			fail "Install file is not writable: $file. Re-run with sudo or fix ownership."
		fi
	done

	if [ -d "$caddy_dir" ] && [ ! -w "$caddy_dir" ]; then
		fail "Caddy config directory is not writable: $caddy_dir. Re-run with sudo or fix ownership."
	fi
}

sanitize_version_tag() {
	local raw="$1"
	if [[ ! "$raw" =~ ^[a-zA-Z0-9._-]+$ ]]; then
		fail "Invalid --version tag. Use only letters, numbers, dots, underscores, and dashes."
	fi
}

parse_install_args() {
	INSTALL_VERSION="$DEFAULT_VERSION"

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--version|-V)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 <tag>."
				fi
				sanitize_version_tag "$2"
				INSTALL_VERSION="$2"
				shift 2
				;;
			-*)
				fail "Unknown install option: $1"
				;;
			*)
				fail "Unexpected install argument: $1"
				;;
		esac
	done
}

parse_upgrade_args() {
	INSTALL_VERSION="$DEFAULT_VERSION"
	UPGRADE_OVERRIDE="false"
	UPGRADE_YES="false"

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--latest)
				INSTALL_VERSION="$DEFAULT_VERSION"
				shift
				;;
			--version|-V)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 <tag>."
				fi
				sanitize_version_tag "$2"
				INSTALL_VERSION="$2"
				shift 2
				;;
			--override)
				UPGRADE_OVERRIDE="true"
				shift
				;;
			--yes|-y)
				UPGRADE_YES="true"
				shift
				;;
			-*)
				fail "Unknown upgrade option: $1"
				;;
			*)
				fail "Unexpected upgrade argument: $1"
				;;
		esac
	done
}

parse_uninstall_args() {
	local yes="false"

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--yes|-y)
				yes="true"
				shift
				;;
			*)
				fail "Unknown uninstall option: $1"
				;;
		esac
	done

	if [ "$yes" != "true" ]; then
		fail "Refusing to uninstall without --yes. This removes containers, named volumes, images, and the install directory."
	fi
}

validate_compose_file() {
	local file="$1"
	local source="$2"

	if [ ! -s "$file" ]; then
		fail "Empty compose file from $source."
	fi

	if grep -Eq '^[[:space:]]*build[[:space:]]*:' "$file"; then
		fail "$source contains a Compose build stanza. nextpress install is Hub-only and only uses published images."
	fi
}

resolve_compose_file() {
	local target="$1"
	local source

	if [ "${NEXTPRESS_COMPOSE_URL:-}" != "" ]; then
		source="NEXTPRESS_COMPOSE_URL"
		curl -fsSL "$NEXTPRESS_COMPOSE_URL" -o "$target" || fail "Could not fetch compose from NEXTPRESS_COMPOSE_URL."
		validate_compose_file "$target" "$source"
		info "Using compose from: $NEXTPRESS_COMPOSE_URL"
		return
	fi

	if [ -f "./$COMPOSE_FILE" ]; then
		source="$(pwd)/$COMPOSE_FILE"
		cp "./$COMPOSE_FILE" "$target"
		validate_compose_file "$target" "$source"
		info "Using compose from: $source"
		return
	fi

	source="$DEFAULT_COMPOSE_SPEC_URL"
	curl -fsSL "$DEFAULT_COMPOSE_SPEC_URL" -o "$target" || fail "Could not fetch compose from default URL."
	validate_compose_file "$target" "$source"
	info "Using compose from: $source"
}

refresh_compose_file() {
	local target="$1"
	local source

	if [ "${NEXTPRESS_COMPOSE_URL:-}" != "" ]; then
		source="NEXTPRESS_COMPOSE_URL"
		curl -fsSL "$NEXTPRESS_COMPOSE_URL" -o "$target" || fail "Could not fetch compose from NEXTPRESS_COMPOSE_URL."
	else
		source="$DEFAULT_COMPOSE_SPEC_URL"
		curl -fsSL "$DEFAULT_COMPOSE_SPEC_URL" -o "$target" || fail "Could not fetch compose from default URL."
	fi

	validate_compose_file "$target" "$source"
	info "Refreshed compose from: $source"
}

generate_secret_hex() {
	openssl rand -hex 16
}

generate_secret_base64() {
	openssl rand -base64 32
}

write_or_update_env() {
	local version="$1"
	local env_path="$INSTALL_DIR/.env"
	local tmp_path

	if ! command_exists openssl; then
		fail "openssl is required to generate install secrets."
	fi

	if [ ! -f "$env_path" ]; then
		umask 077
		cat > "$env_path" <<EOF
POSTGRES_PASSWORD=$(generate_secret_hex)
SESSION_SECRET=$(generate_secret_base64)
NEXTPRESS_VERSION=$version
EOF
		info "Generated new .env with secrets."
		return
	fi

	tmp_path="$(mktemp)"
	if grep -q '^NEXTPRESS_VERSION=' "$env_path"; then
		awk -v version="$version" 'BEGIN{done=0} /^NEXTPRESS_VERSION=/{print "NEXTPRESS_VERSION=" version; done=1; next} {print} END{if(done==0) print "NEXTPRESS_VERSION=" version}' "$env_path" > "$tmp_path"
	else
		cat "$env_path" > "$tmp_path"
		printf '%s\n' "NEXTPRESS_VERSION=$version" >> "$tmp_path"
	fi
	cat "$tmp_path" > "$env_path"
	rm -f "$tmp_path"
	info "Updated NEXTPRESS_VERSION in existing .env."
}

load_install_env() {
	local env_path="$INSTALL_DIR/.env"

	if [ ! -f "$env_path" ]; then
		fail "Missing install environment file: $env_path"
	fi

	POSTGRES_PASSWORD="$(awk -F= '/^POSTGRES_PASSWORD=/{print substr($0, index($0, "=") + 1); exit}' "$env_path")"
	if [ "${POSTGRES_PASSWORD:-}" = "" ]; then
		fail "Missing POSTGRES_PASSWORD in $env_path"
	fi
}

detect_caddy_site_hosts() {
	local caddy_file="$INSTALL_DIR/caddy_config/Caddyfile"

	if [ ! -f "$caddy_file" ]; then
		return 0
	fi

	# The site-address line lists hostnames before the opening brace, e.g.
	# "example.com, www.example.com {". The global options block opens with a
	# bare "{" and IP/localhost installs use ":80 {", neither of which starts
	# with an alphanumeric host character, so they are skipped.
	awk '/^[A-Za-z0-9][^{]*\{[[:space:]]*$/ {
		line = $0
		sub(/[[:space:]]*\{[[:space:]]*$/, "", line)
		print line
		exit
	}' "$caddy_file"
}

# Single-domain installs: pin BETTER_AUTH_URL so Better Auth emits Secure
# cookies and trusts the public origin explicitly. Login already works via the
# app's dynamic same-origin trust, so this is best-effort hardening only:
# skipped when a value already exists, when multiple domains are served, or for
# IP/localhost (no public HTTPS host).
maybe_set_auth_url_from_caddy() {
	local env_path="$INSTALL_DIR/.env"
	local hosts_line apexes apex_count domain

	if [ ! -f "$env_path" ]; then
		return 0
	fi

	if grep -q '^BETTER_AUTH_URL=' "$env_path"; then
		return 0
	fi

	hosts_line="$(detect_caddy_site_hosts)"
	if [ "$hosts_line" = "" ]; then
		return 0
	fi

	apexes="$(printf '%s' "$hosts_line" | tr ',' '\n' \
		| awk '{gsub(/[[:space:]]/, ""); if ($0 == "") next; sub(/^www\./, ""); print}' \
		| sort -u)"
	apex_count="$(printf '%s\n' "$apexes" | grep -c .)"

	if [ "$apex_count" -ne 1 ]; then
		warn "Multiple site domains detected; leaving BETTER_AUTH_URL unset. Login still works via dynamic origin trust."
		return 0
	fi

	domain="$(printf '%s\n' "$apexes" | head -n1)"
	printf 'BETTER_AUTH_URL=https://%s\n' "$domain" >> "$env_path"
	info "Set BETTER_AUTH_URL=https://$domain in .env (auto-detected from Caddyfile)."
}

write_initial_caddyfile() {
	local caddy_dir="$INSTALL_DIR/caddy_config"
	local caddy_file="$caddy_dir/Caddyfile"

	mkdir -p "$caddy_dir" || fail "Could not create Caddy config directory: $caddy_dir"
	if [ -f "$caddy_file" ]; then
		return
	fi

	cat > "$caddy_file" <<'EOF' || fail "Could not write initial Caddyfile: $caddy_file"
{
  admin 0.0.0.0:2019
  email info@nextpress.ai
}

# First-boot catch-all. Docker publishes this through http://nextpress.localhost.
:80 {
  reverse_proxy app:5000
}
EOF
}

try_chown_to_sudo_user() {
	if [ "${SUDO_USER:-}" = "" ] || [ "$SUDO_USER" = "root" ]; then
		return
	fi

	if id "$SUDO_USER" >/dev/null 2>&1; then
		chown -R "$SUDO_USER":"$SUDO_USER" "$INSTALL_DIR" || true
	fi
}

compose() {
	if docker_accessible && docker compose version >/dev/null 2>&1; then
		docker compose -f "$COMPOSE_FILE" "$@"
		return
	fi

	if sudo_docker_accessible; then
		sudo docker compose -f "$COMPOSE_FILE" "$@"
		return
	fi

	fail "Docker is not accessible. Install Docker or run with a user that can access Docker."
}

docker_cmd() {
	if docker_accessible; then
		docker "$@"
		return
	fi

	if sudo_docker_accessible; then
		sudo docker "$@"
		return
	fi

	fail "Docker is not accessible. Install Docker or run with a user that can access Docker."
}

app_image() {
	printf '%s\n' "husseinkizz/nextpress:${INSTALL_VERSION}"
}

read_json_value() {
	local file="$1"
	local key="$2"

	if [ ! -f "$file" ]; then
		return 1
	fi

	if [ -r "$file" ]; then
		awk -v key="$key" '
			$0 ~ "\"" key "\"" {
				sub(/^[^:]*:[[:space:]]*/, "")
				sub(/[[:space:]]*,?[[:space:]]*$/, "")
				gsub(/^"|"$/, "")
				print
				exit
			}
		' "$file"
		return
	fi

	if command_exists sudo; then
		sudo awk -v key="$key" '
			$0 ~ "\"" key "\"" {
				sub(/^[^:]*:[[:space:]]*/, "")
				sub(/[[:space:]]*,?[[:space:]]*$/, "")
				gsub(/^"|"$/, "")
				print
				exit
			}
		' "$file"
		return
	fi

	return 1
}

chmod_schema_config() {
	local file="$1"

	if chmod 0644 "$file" 2>/dev/null; then
		return
	fi

	if command_exists sudo; then
		sudo chmod 0644 "$file" || fail "Could not set readable permissions on $file."
		return
	fi

	fail "Could not set readable permissions on $file."
}

write_schema_config_file() {
	local target="$1"
	local tmp_path

	tmp_path="$(mktemp)"
	cat > "$tmp_path" <<'EOF' || fail "Could not prepare schema config: $target"
{
  "schemaVersion": "legacy",
  "previousSchemaVersion": "legacy",
  "schemaPath": "shared/schema.ts",
  "hasSchemaChanges": false
}
EOF

	if ! cp "$tmp_path" "$target" 2>/dev/null; then
		if command_exists sudo; then
			sudo cp "$tmp_path" "$target" || fail "Could not write schema config: $target"
		else
			fail "Could not write schema config: $target"
		fi
	fi
	rm -f "$tmp_path"
	chmod_schema_config "$target"
}

read_config_value() {
	local file="$1"
	local key="$2"
	local value

	value="$(read_json_value "$file" "$key" || true)"
	if [ "$value" = "" ]; then
		fail "Missing $key in $file."
	fi

	printf '%s\n' "$value"
}

copy_release_config_from_image() {
	local image="$1"
	local target="$2"
	local container_id

	container_id="$(docker_cmd create "$image" 2>/dev/null)" || fail "Could not inspect release config from image: $image"
	docker_cmd cp "$container_id:/app/$RELEASE_CONFIG_FILE" "$target" >/dev/null || {
		docker_cmd rm -f "$container_id" >/dev/null 2>&1 || true
		fail "Release image does not include $RELEASE_CONFIG_FILE: $image"
	}
	docker_cmd rm -f "$container_id" >/dev/null 2>&1 || true
}

write_legacy_installed_config() {
	local config_path="$INSTALL_DIR/$RELEASE_CONFIG_FILE"

	if [ -f "$config_path" ]; then
		return
	fi

	write_schema_config_file "$config_path"
}

copy_installed_config() {
	local source="$1"
	local target="$INSTALL_DIR/$RELEASE_CONFIG_FILE"

	if ! cp "$source" "$target" 2>/dev/null; then
		if command_exists sudo; then
			sudo cp "$source" "$target" || fail "Could not update installed schema config."
		else
			fail "Could not update installed schema config."
		fi
	fi
	chmod_schema_config "$target"
}

cleanup_target_config() {
	local config_path="${1:-}"
	if [ "$config_path" = "" ]; then
		return
	fi

	rm -f "$config_path" 2>/dev/null || true
}

create_db_backup() {
	local backup_dir="$INSTALL_DIR/$BACKUP_DIR"
	local backup_path
	local timestamp

	timestamp="$(date +%Y%m%d%H%M%S)"
	backup_path="$backup_dir/nextpress-db-$timestamp.sql"
	mkdir -p "$backup_dir" || fail "Could not create backup directory: $backup_dir"

	info "Creating database backup: $backup_path"
	if ! compose exec -T postgres pg_dump -U postgres nextpress > "$backup_path"; then
		rm -f "$backup_path"
		fail "Database backup failed; refusing to continue."
	fi

	info "Database backup created: $backup_path"
}

confirm_override() {
	if [ "$UPGRADE_YES" = "true" ]; then
		return
	fi

	if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
		fail "Refusing override without an interactive terminal. Re-run with --override --yes if you accept data reset."
	fi

	local answer=""
	printf '%s' "Override may reset existing database state after backup. Continue? Type yes: " >/dev/tty
	IFS= read -r answer </dev/tty || fail "Could not read override confirmation."
	if [ "$answer" != "yes" ]; then
		fail "Override cancelled."
	fi
}

confirm_reset() {
	if [ "$RESET_YES" = "true" ]; then
		return
	fi

	if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
		fail "Refusing to reset without an interactive terminal. Re-run with --yes if you accept data loss."
	fi

	local answer=""
	printf '%s' "This erases ALL data in $INSTALL_DIR (a backup is made first). Continue? Type yes: " >/dev/tty
	IFS= read -r answer </dev/tty || fail "Could not read reset confirmation."
	if [ "$answer" != "yes" ]; then
		fail "Reset cancelled."
	fi
}

run_reset() {
	parse_reset_args "$@"
	assert_install_dir_exists
	assert_docker_available
	load_install_env

	info "Preparing to reset NextPress in $INSTALL_DIR to a fresh install..."

	# Bring postgres up so we can back up and wipe it.
	ensure_postgres_running

	confirm_reset

	# Auto-backup before wiping (reversible).
	create_db_backup

	# Stop the app so no connections hold the schema open.
	info "Stopping app service..."
	compose stop app || true

	# Wipe the database schema; migrations recreate it from scratch.
	info "Dropping all data (DROP SCHEMA public CASCADE)..."
	if ! compose exec -T postgres psql -U postgres -d nextpress -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"; then
		fail "Could not reset the database. The backup is intact; nothing else was changed."
	fi

	# Re-apply migrations + seed default content (fresh-install parity).
	run_schema_migrations "$(app_image)"
	run_default_content_seed

	# Clear uploaded media (volume-backed at /app/uploads).
	info "Clearing uploaded media..."
	compose run --rm --no-deps app rm -rf /app/uploads/* || warn "Could not clear uploads; remove them manually if needed."

	# Bring everything back up.
	info "Restarting services..."
	compose up -d
	wait_for_app_health

	info "Reset complete. The instance is fresh (default content seeded)."
	info "Your pre-reset backup is in $INSTALL_DIR/$BACKUP_DIR/"
}

reset_database_volume() {
	local container_id
	local volume_name

	info "Resetting database volume for override upgrade..."

	container_id="$(compose ps -q postgres || true)"
	if [ "$container_id" != "" ]; then
		volume_name="$(docker_cmd inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "$container_id")"
	fi

	compose down --remove-orphans

	if [ "${volume_name:-}" = "" ]; then
		fail "Could not determine database volume name for override reset."
	fi

	docker_cmd volume rm "$volume_name" >/dev/null 2>&1 || warn "Could not remove database volume: $volume_name. It may already be absent."
}

get_free_mb() {
	local path="$1"
	df -Pm "$path" 2>/dev/null | awk 'NR==2 {print $4}'
}

get_docker_data_path() {
	local root
	root="$(docker_cmd info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
	if [ "$root" = "" ]; then
		printf '%s\n' "/var/lib/docker"
		return
	fi
	printf '%s\n' "$root"
}

free_upgrade_disk_space() {
	local target_image old_image old_backup

	target_image="$(app_image)"
	info "Freeing disk space before upgrade..."

	if [ -d "$BACKUP_DIR" ]; then
		while IFS= read -r old_backup; do
			[ -n "$old_backup" ] || continue
			rm -f "$old_backup"
			info "Removed old backup: $(basename "$old_backup")"
		done < <(ls -t "$BACKUP_DIR"/nextpress-db-*.sql 2>/dev/null | tail -n +$((BACKUP_KEEP_COUNT + 1)) || true)
	fi

	docker_cmd image prune -f >/dev/null 2>&1 || true

	while IFS= read -r old_image; do
		[ -n "$old_image" ] || continue
		[ "$old_image" = "$target_image" ] && continue
		if docker_cmd rmi "$old_image" >/dev/null 2>&1; then
			info "Removed old image: $old_image"
		fi
	done < <(docker_cmd images "husseinkizz/nextpress" --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -v '<none>' || true)
}

assert_disk_space_for_upgrade() {
	local install_free docker_root docker_free

	install_free="$(get_free_mb "$INSTALL_DIR")"
	docker_root="$(get_docker_data_path)"
	docker_free="$(get_free_mb "$docker_root")"

	if [ "${install_free:-0}" -lt "$MIN_FREE_MB_INSTALL" ]; then
		fail "Need at least ${MIN_FREE_MB_INSTALL}MB free at $INSTALL_DIR (found ${install_free:-unknown}MB). Free disk space, then rerun: nextpress upgrade"
	fi

	if [ "${docker_free:-0}" -lt "$MIN_FREE_MB_DOCKER" ]; then
		fail "Need at least ${MIN_FREE_MB_DOCKER}MB free for Docker at $docker_root (found ${docker_free:-unknown}MB). Free disk space, then rerun: nextpress upgrade"
	fi

	info "Disk check OK: ${install_free}MB at install dir, ${docker_free}MB for Docker."
}

stop_app_services() {
	info "Stopping app services before database work..."
	compose stop app caddy 2>/dev/null || true
}

prepare_upgrade_workspace() {
	stop_app_services
	refresh_compose_file "$COMPOSE_FILE"
	free_upgrade_disk_space
	assert_disk_space_for_upgrade
}

try_self_update_for_upgrade() {
	local upgrade_args=("$@")
	local bin_path tmp_path updated url

	if [ "${NEXTPRESS_UPGRADE_REEXEC:-}" = "true" ]; then
		return
	fi

	bin_path="$(command -v nextpress 2>/dev/null || true)"
	if [ "$bin_path" = "" ]; then
		return
	fi

	url="$DEFAULT_COMMAND_URL"
	tmp_path="$(mktemp)"
	if ! curl -fsSL "$url" -o "$tmp_path"; then
		rm -f "$tmp_path"
		warn "Could not update nextpress command; continuing with installed version."
		return
	fi

	if cmp -s "$tmp_path" "$bin_path" 2>/dev/null; then
		rm -f "$tmp_path"
		return
	fi

	chmod +x "$tmp_path"
	updated="false"
	if cp "$tmp_path" "$bin_path" 2>/dev/null; then
		updated="true"
	elif command_exists sudo && sudo cp "$tmp_path" "$bin_path"; then
		updated="true"
	fi
	rm -f "$tmp_path"

	if [ "$updated" = "true" ]; then
		info "Updated nextpress command from $url"
		export NEXTPRESS_UPGRADE_REEXEC=true
		# Pass the install dir on: without it the new command would upgrade the default install instead.
		exec "$bin_path" --install-dir "$INSTALL_DIR" upgrade "${upgrade_args[@]}"
	fi
}

wait_for_app_health() {
	local attempt=0
	local max_attempts=30

	info "Waiting for app health check..."
	while [ "$attempt" -lt "$max_attempts" ]; do
		if compose exec -T app node -e "fetch('http://127.0.0.1:5000/api/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" >/dev/null 2>&1; then
			info "App is healthy."
			return 0
		fi
		sleep 2
		attempt=$((attempt + 1))
	done

	fail "App health check failed after upgrade. Check: nextpress logs app"
}

start_upgrade_stack() {
	ensure_postgres_running
	compose up -d
	wait_for_app_health
}

postgres_accepts_queries() {
	compose exec -T postgres psql -U postgres -d nextpress -c 'SELECT 1' >/dev/null 2>&1
}

ensure_postgres_running() {
	local attempt=0
	local max_attempts=60
	local restarted="false"

	try_postgres_ready() {
		attempt=0
		while [ "$attempt" -lt "$max_attempts" ]; do
			if postgres_accepts_queries; then
				info "Database is ready."
				return 0
			fi
			sleep 2
			attempt=$((attempt + 1))
		done
		return 1
	}

	info "Starting database service..."
	compose up -d postgres
	info "Waiting for database to accept queries (max ${max_attempts} attempts)..."

	if try_postgres_ready; then
		return 0
	fi

	if [ "$restarted" = "false" ]; then
		warn "Database not ready; restarting postgres once..."
		compose restart postgres
		restarted="true"
		if try_postgres_ready; then
			return 0
		fi
	fi

	fail "Database did not accept queries. Check: nextpress logs postgres"
}

run_schema_migrations() {
	local image="${1:-$(app_image)}"

	info "Applying database migrations from $image..."
	compose run --rm --no-deps app node -e '
const { existsSync } = require("node:fs");
const { spawnSync } = require("node:child_process");
if (existsSync("dist/migrate.js")) {
  const result = spawnSync(process.execPath, ["dist/migrate.js"], { stdio: "inherit" });
  if (result.error) console.error("[migrate] Could not start migration runner:", result.error);
  process.exit(result.status ?? 1);
}
console.warn("[migrate] Older image; using drizzle-kit migrate.");
const result = spawnSync("pnpm", ["drizzle-kit", "migrate"], { stdio: "inherit" });
if (result.error) console.error("[migrate] Could not start legacy runner:", result.error);
process.exit(result.status ?? 1);
'
}

run_default_content_seed() {
	info "Seeding default templates and themes if missing..."
	compose run --rm --no-deps app node dist/seed-default-content.js
}

resolve_public_ip() {
	local public_ip
	local service_url

	if [ "${NEXTPRESS_PUBLIC_IP:-}" != "" ]; then
		printf '%s\n' "$NEXTPRESS_PUBLIC_IP"
		return
	fi

	if [ -r /dev/tty ] && [ -w /dev/tty ]; then
		public_ip="$(prompt_public_ip 2>/dev/null || true)"
		if [ "$public_ip" != "" ]; then
			printf '%s\n' "$public_ip"
		fi
		return
	fi

	for service_url in "https://api.ipify.org" "https://ifconfig.me/ip"; do
		public_ip="$(curl -fsS --max-time 3 "$service_url" 2>/dev/null | tr -d '[:space:]' || true)"
		if [ "$public_ip" != "" ]; then
			printf '%s\n' "$public_ip"
			return
		fi
	done
}

prompt_public_ip() {
	local access_answer=""
	local public_ip=""

	printf '%s' "Will you access this NextPress instance from another machine? [y/N]: " >/dev/tty
	IFS= read -r access_answer </dev/tty || return 1
	case "$access_answer" in
		y|Y|yes|YES|Yes) ;;
		*) return ;;
	esac

	printf '%s' "Enter the public IP or hostname for this server: " >/dev/tty
	IFS= read -r public_ip </dev/tty || return 1
	public_ip="$(printf '%s' "$public_ip" | awk '{$1=$1; print}')"
	if [ "$public_ip" = "" ]; then
		return
	fi

	printf '%s\n' "$public_ip"
}

resolve_private_ip() {
	local server_ip

	server_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
	if [ "$server_ip" = "" ]; then
		server_ip="$(ip route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "src") {print $(i + 1); exit}}')"
	fi

	if [ "$server_ip" != "" ]; then
		printf '%s\n' "$server_ip"
	fi
}

print_post_install_hints() {
	local private_ip
	local public_ip
	local version="$1"
	public_ip="$(resolve_public_ip)"
	private_ip="$(resolve_private_ip)"

	cat <<EOF

============================================
       Installation complete
============================================

NextPress $version is running (Docker Hub image + compose stack).

Open the setup wizard in your browser:
  Local:   $SETUP_URL
  Public:  http://${public_ip:-YOUR_SERVER_IP}
  Private: http://${private_ip:-PRIVATE_SERVER_IP}

Allow inbound TCP ports 80 and 443 in your server firewall.

Useful commands:
  nextpress status
  nextpress logs
  nextpress upgrade
  nextpress restart
  nextpress uninstall --yes
EOF
}

add_entity_flag() {
	local entity="$1"
	if [[ ",$TRANSFER_ENTITIES_SELECTED," != *",$entity,"* ]]; then
		TRANSFER_ENTITIES_SELECTED="${TRANSFER_ENTITIES_SELECTED:+$TRANSFER_ENTITIES_SELECTED,}$entity"
	fi
}

parse_export_args() {
	TRANSFER_ENTITIES_SELECTED=""
	TRANSFER_SITE=""
	TRANSFER_WITH_MEDIA="false"
	TRANSFER_OUT=""
	TRANSFER_FORCE="false"

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--users) add_entity_flag users; shift ;;
			--sites) add_entity_flag sites; shift ;;
			--pages) add_entity_flag pages; shift ;;
			--blogs) add_entity_flag blogs; shift ;;
			--posts) add_entity_flag posts; shift ;;
			--comments) add_entity_flag comments; shift ;;
			--media) add_entity_flag media; shift ;;
			--templates) add_entity_flag templates; shift ;;
			--options) add_entity_flag options; shift ;;
			--site)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 <slug>."
				fi
				TRANSFER_SITE="$2"
				shift 2
				;;
			--with-media-files)
				TRANSFER_WITH_MEDIA="true"
				shift
				;;
			--out)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 <path>."
				fi
				TRANSFER_OUT="$2"
				shift 2
				;;
			--force)
				TRANSFER_FORCE="true"
				shift
				;;
			-*)
				fail "Unknown export option: $1"
				;;
		*)
			fail "Unexpected export argument: $1"
			;;
		esac
	done
}

parse_reset_args() {
	RESET_YES="false"
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--yes) RESET_YES="true"; shift ;;
			-*) fail "Unknown reset option: $1" ;;
			*) fail "Unexpected reset argument: $1" ;;
		esac
	done
}

parse_import_args() {
	TRANSFER_ENTITIES_SELECTED=""
	TRANSFER_MODE="overwrite"
	TRANSFER_FILE=""

	while [ "$#" -gt 0 ]; do
		case "$1" in
			--users) add_entity_flag users; shift ;;
			--sites) add_entity_flag sites; shift ;;
			--pages) add_entity_flag pages; shift ;;
			--blogs) add_entity_flag blogs; shift ;;
			--posts) add_entity_flag posts; shift ;;
			--comments) add_entity_flag comments; shift ;;
			--media) add_entity_flag media; shift ;;
			--templates) add_entity_flag templates; shift ;;
			--options) add_entity_flag options; shift ;;
			--mode)
				if [ "${2:-}" = "" ] || [[ "${2:-}" == -* ]]; then
					fail "Missing value for $1. Use $1 overwrite|skip."
				fi
				if [ "$2" != "overwrite" ] && [ "$2" != "skip" ]; then
					fail "Invalid --mode value: $2. Use overwrite or skip."
				fi
				TRANSFER_MODE="$2"
				shift 2
				;;
			-*)
				fail "Unknown import option: $1"
				;;
			*)
				if [ "$TRANSFER_FILE" != "" ]; then
					fail "Unexpected import argument: $1"
				fi
				TRANSFER_FILE="$1"
				shift
				;;
		esac
	done

	if [ "$TRANSFER_FILE" = "" ]; then
		fail "Missing import file. Use: nextpress import <file> [options]"
	fi
}

assert_app_running() {
	assert_install_dir_exists
	assert_docker_available

	if [ ! -f "$INSTALL_DIR/$COMPOSE_FILE" ]; then
		fail "No compose file found in $INSTALL_DIR. Install first: nextpress install"
	fi

	if ! (cd "$INSTALL_DIR" && compose ps --status running -q app 2>/dev/null | grep -q .); then
		fail "NextPress is not running. Start it first: nextpress restart"
	fi
}

assert_transfer_ready() {
	assert_app_running

	if ! (cd "$INSTALL_DIR" && compose exec -T app test -f "$TRANSFER_RUNNER") >/dev/null 2>&1; then
		fail "This NextPress version predates export/import. Run: nextpress upgrade"
	fi
}

parse_reset_password_args() {
	RESET_PASSWORD_LOGIN=""
	RESET_PASSWORD_STDIN="false"
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--password-stdin) RESET_PASSWORD_STDIN="true"; shift ;;
			-*) fail "Unknown reset-password option: $1" ;;
			*)
				if [ "$RESET_PASSWORD_LOGIN" != "" ]; then
					fail "Give one email or username. Use: nextpress reset-password <email or username>"
				fi
				RESET_PASSWORD_LOGIN="$1"
				shift
				;;
		esac
	done

	if [ "$RESET_PASSWORD_LOGIN" = "" ]; then
		fail "Missing email or username. Use: nextpress reset-password <email or username>"
	fi
}

# Sets NEW_PASSWORD without ever showing it or putting it in an argument (shell
# history, process list). Length rules live in the app, so they match sign-in.
read_new_password() {
	NEW_PASSWORD=""
	if [ "$RESET_PASSWORD_STDIN" = "true" ]; then
		IFS= read -r NEW_PASSWORD || [ "$NEW_PASSWORD" != "" ] || fail "No password came in on the pipe. Nothing was changed."
		return
	fi

	# Opening it is the real test: /dev/tty keeps its permissions even when there is no terminal.
	if ! { true </dev/tty >/dev/tty; } 2>/dev/null; then
		fail "Refusing to ask for a password without an interactive terminal. Pipe it in with --password-stdin."
	fi

	local again=""
	printf '%s' "New password: " >/dev/tty
	IFS= read -rs NEW_PASSWORD </dev/tty || fail "Could not read the password. Nothing was changed."
	printf '\n' >/dev/tty
	printf '%s' "Type it again: " >/dev/tty
	IFS= read -rs again </dev/tty || fail "Could not read the password. Nothing was changed."
	printf '\n' >/dev/tty

	if [ "$NEW_PASSWORD" != "$again" ]; then
		fail "The two passwords don't match. Nothing was changed."
	fi
}

run_reset_password() {
	parse_reset_password_args "$@"
	assert_app_running

	if ! (cd "$INSTALL_DIR" && compose exec -T app test -f "$RESET_PASSWORD_RUNNER") >/dev/null 2>&1; then
		fail "This NextPress version can't reset passwords yet. Run: nextpress upgrade"
	fi

	read_new_password
	# The app checks the password, saves it and prints the outcome; its exit code is ours.
	(cd "$INSTALL_DIR" && printf '%s\n' "$NEW_PASSWORD" | compose exec -T app node "$RESET_PASSWORD_RUNNER" "$RESET_PASSWORD_LOGIN")
}

run_export() {
	parse_export_args "$@"
	assert_transfer_ready

	local out="$TRANSFER_OUT"
	local ext="json"
	local entities_args=()
	local site_args=()
	local media_args=()

	if [ "$TRANSFER_WITH_MEDIA" = "true" ]; then
		ext="tar.gz"
	fi

	if [ "$out" = "" ]; then
		out="$(pwd)/nextpress-export-$(date +%Y%m%d-%H%M%S).$ext"
	fi

	# Absolutize so the redirect inside the subshell (which cds to INSTALL_DIR)
	# does not resolve a relative --out against the wrong directory.
	case "$out" in
		/*) ;;
		*) out="$(pwd)/$out" ;;
	esac

	if [ -e "$out" ] && [ "$TRANSFER_FORCE" != "true" ]; then
		fail "Output file already exists: $out. Use --force to overwrite it."
	fi

	if [ "$TRANSFER_ENTITIES_SELECTED" != "" ]; then
		entities_args=(--entities "$TRANSFER_ENTITIES_SELECTED")
	fi
	if [ "$TRANSFER_SITE" != "" ]; then
		site_args=(--site "$TRANSFER_SITE")
	fi
	if [ "$TRANSFER_WITH_MEDIA" = "true" ]; then
		media_args=(--with-media-files)
	fi

	# Write to a temp file first so a failed export never clobbers an existing
	# file; only a successful export is moved into place.
	local tmp_out="${out}.tmp.$$"
	info "Exporting NextPress data to: $out"
	if ! (cd "$INSTALL_DIR" && compose exec -T app node "$TRANSFER_RUNNER" export "${entities_args[@]}" "${site_args[@]}" "${media_args[@]}" > "$tmp_out"); then
		rm -f "$tmp_out"
		fail "Export failed. See messages above for details."
	fi
	mv "$tmp_out" "$out"
	info "Export complete: $out"
}

run_import() {
	parse_import_args "$@"
	assert_transfer_ready

	local file="$TRANSFER_FILE"
	local entities_args=()

	# Absolutize so the redirect inside the subshell (which cds to INSTALL_DIR)
	# does not resolve a relative path against the wrong directory.
	case "$file" in
		/*) ;;
		*) file="$(pwd)/$file" ;;
	esac

	if [ ! -f "$file" ]; then
		fail "Import file not found: $file"
	fi
	if [ ! -r "$file" ]; then
		fail "Import file is not readable: $file"
	fi
	if [ ! -s "$file" ]; then
		fail "Import file is empty: $file"
	fi

	if [ "$TRANSFER_ENTITIES_SELECTED" != "" ]; then
		entities_args=(--entities "$TRANSFER_ENTITIES_SELECTED")
	fi

	info "Importing NextPress data from: $file"
	if ! (cd "$INSTALL_DIR" && compose exec -T app node "$TRANSFER_RUNNER" import "${entities_args[@]}" --mode "$TRANSFER_MODE" < "$file"); then
		fail "Import failed. See messages above for details."
	fi
	info "Import complete."
}

run_install() {
	parse_install_args "$@"
	local target_config

	assert_docker_available
	mkdir -p "$INSTALL_DIR" || fail "Could not create install directory: $INSTALL_DIR"
	assert_install_dir_writable

	info "Resolving docker-compose.prod.yml..."
	resolve_compose_file "$INSTALL_DIR/$COMPOSE_FILE"
	write_initial_caddyfile
	write_or_update_env "$INSTALL_VERSION"
	try_chown_to_sudo_user
	load_install_env

	info ""
	info "Pulling images from Docker Hub..."
	(cd "$INSTALL_DIR" && compose pull)

	info ""
	target_config="$(mktemp)"
	trap 'cleanup_target_config "$target_config"' RETURN
	(cd "$INSTALL_DIR" && copy_release_config_from_image "$(app_image)" "$target_config")
	(cd "$INSTALL_DIR" && ensure_postgres_running)
	(cd "$INSTALL_DIR" && run_schema_migrations "$(app_image)")
	(cd "$INSTALL_DIR" && run_default_content_seed)
	copy_installed_config "$target_config"
	cleanup_target_config "$target_config"
	trap - RETURN

	info ""
	info "Starting services..."
	(cd "$INSTALL_DIR" && compose up -d)
	ensure_update_helper

	sleep 3
	print_post_install_hints "$INSTALL_VERSION"
}

run_upgrade() {
	parse_upgrade_args "$@"
	try_self_update_for_upgrade "$@"
	local current_config
	local current_schema_version
	local has_schema_changes
	local previous_schema_version
	local target_config
	local target_schema_version

	assert_install_dir_exists
	acquire_upgrade_lock
	assert_docker_available
	load_install_env
	write_legacy_installed_config
	maybe_set_auth_url_from_caddy

	info "Upgrading stack in $INSTALL_DIR to $INSTALL_VERSION..."
	(cd "$INSTALL_DIR" && prepare_upgrade_workspace)

	if [ "${NEXTPRESS_SKIP_IMAGE_PULL:-}" = "true" ]; then
		info "Skipping image pull because NEXTPRESS_SKIP_IMAGE_PULL=true."
	else
		info "Pulling image: $(app_image)"
		docker_cmd pull "$(app_image)"
	fi

	target_config="$(mktemp)"
	trap 'cleanup_target_config "$target_config"' RETURN
	(cd "$INSTALL_DIR" && copy_release_config_from_image "$(app_image)" "$target_config")
	current_config="$INSTALL_DIR/$RELEASE_CONFIG_FILE"
	current_schema_version="$(read_config_value "$current_config" "schemaVersion")"
	target_schema_version="$(read_config_value "$target_config" "schemaVersion")"
	previous_schema_version="$(read_config_value "$target_config" "previousSchemaVersion")"
	has_schema_changes="$(read_config_value "$target_config" "hasSchemaChanges")"

	if [ "$current_schema_version" = "$target_schema_version" ]; then
		info "Schema is already at $target_schema_version."
		write_or_update_env "$INSTALL_VERSION"
		copy_installed_config "$target_config"
		cleanup_target_config "$target_config"
		trap - RETURN
		(cd "$INSTALL_DIR" && ensure_postgres_running)
		(cd "$INSTALL_DIR" && run_default_content_seed)
		(cd "$INSTALL_DIR" && start_upgrade_stack)
		info "Upgrade complete. Schema is now $target_schema_version."
		ensure_update_helper
		return
	fi

	if [ "$has_schema_changes" = "true" ] && [ "$current_schema_version" != "$previous_schema_version" ]; then
		if [ "$UPGRADE_OVERRIDE" != "true" ]; then
			rm -f "$target_config"
			trap - RETURN
			fail "Schema upgrade expects $previous_schema_version but this install is on $current_schema_version. Upgrade through the required intermediate version, or rerun with --override if you accept database reset."
		fi
		(cd "$INSTALL_DIR" && ensure_postgres_running)
		(cd "$INSTALL_DIR" && create_db_backup)
		confirm_override
		(cd "$INSTALL_DIR" && reset_database_volume)
		write_or_update_env "$INSTALL_VERSION"
		load_install_env
		(cd "$INSTALL_DIR" && ensure_postgres_running)
		(cd "$INSTALL_DIR" && run_schema_migrations "$(app_image)")
		(cd "$INSTALL_DIR" && run_default_content_seed)
		copy_installed_config "$target_config"
		cleanup_target_config "$target_config"
		trap - RETURN
		(cd "$INSTALL_DIR" && start_upgrade_stack)
		info "Override upgrade complete. Schema is now $target_schema_version."
		ensure_update_helper
		return
	fi

	if [ "$has_schema_changes" = "true" ]; then
		(cd "$INSTALL_DIR" && ensure_postgres_running)
		(cd "$INSTALL_DIR" && create_db_backup)
		write_or_update_env "$INSTALL_VERSION"
		load_install_env
		(cd "$INSTALL_DIR" && run_schema_migrations "$(app_image)")
		(cd "$INSTALL_DIR" && run_default_content_seed)
	else
		info "No schema changes declared for this release."
		write_or_update_env "$INSTALL_VERSION"
		load_install_env
		(cd "$INSTALL_DIR" && ensure_postgres_running)
		(cd "$INSTALL_DIR" && run_default_content_seed)
	fi

	copy_installed_config "$target_config"
	cleanup_target_config "$target_config"
	trap - RETURN
	(cd "$INSTALL_DIR" && start_upgrade_stack)
	info "Upgrade complete. Schema is now $target_schema_version."
	ensure_update_helper
}

# One upgrade at a time on an install, whether started by hand or from the
# dashboard. Needs flock (util-linux); without it nothing changes.
acquire_upgrade_lock() {
	local lock_path="$INSTALL_DIR/$UPGRADE_LOCK_FILE"

	if ! command_exists flock; then
		return 0
	fi
	if ! { exec 8>>"$lock_path"; } 2>/dev/null; then
		warn "Could not open $lock_path; continuing without the upgrade lock."
		return 0
	fi
	if ! flock -n 8; then
		fail "Another NextPress update is already running on this server. Wait for it to finish, then try again."
	fi
}

# True while another upgrade holds the lock (flock exits 1 only for "busy").
upgrade_lock_busy() {
	local lock_path="$INSTALL_DIR/$UPGRADE_LOCK_FILE"
	local status=0

	if ! command_exists flock || [ ! -f "$lock_path" ]; then
		return 1
	fi
	flock -n "$lock_path" true 2>/dev/null || status=$?
	[ "$status" -eq 1 ]
}

# ---------------------------------------------------------------------------
# Updates from the admin dashboard (the "update helper")
#
# The app never gets Docker or host access. When a main-site admin confirms an
# update, the app only writes request.json into $INSTALL_DIR/update, which
# compose mounts at /app/update. A systemd path unit on this host notices the
# file and runs `nextpress update-runner`. The runner checks the request on its
# own (only the newest official release is ever installed), downloads it while
# the sites stay online, then runs the normal `nextpress upgrade`, and puts the
# previous version back if that fails. It writes update/status.json for the
# dashboard. Its log, lock and scratch files live in $INSTALL_DIR/update-logs,
# which the app cannot see. Files written into update/ are always fresh files
# renamed into place, so a link planted there is replaced, never written
# through.
#
# Switch: nextpress update-helper on|off|status
# ---------------------------------------------------------------------------

UPDATE_RUN_REQUEST_ID=""
UPDATE_RUN_VERSION=""
UPDATE_RUN_FROM_TAG=""
UPDATE_RUN_STARTED_AT=""
UPDATE_RUN_LOG_PATH=""
UPDATE_RUN_FINISHED="false"
UPDATE_CLI_SELF=""

update_dir() {
	printf '%s\n' "$INSTALL_DIR/$UPDATE_DIR_NAME"
}

update_log_dir() {
	printf '%s\n' "$INSTALL_DIR/$UPDATE_LOG_DIR_NAME"
}

utc_now() {
	date -u +%Y-%m-%dT%H:%M:%SZ
}

running_as_root() {
	[ "$(id -u)" -eq 0 ]
}

systemd_available() {
	command_exists systemctl && [ -d /run/systemd/system ]
}

systemd_unit_dir() {
	printf '%s\n' "/etc/systemd/system"
}

# Releases are vX.Y.Z on GitHub and beta-vX.Y.Z on Docker Hub (deploy.sh
# VERSION_TAG). Same mapping as releaseImageTag in shared/core-update.
release_image_tag() {
	printf 'beta-v%s\n' "$1"
}

# Same image repository as app_image.
release_image_ref() {
	printf 'husseinkizz/nextpress:%s\n' "$(release_image_tag "$1")"
}

is_release_version() {
	[[ "$1" =~ ^[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}$ ]]
}

# Request and user ids (UUIDs, or the app's own ids in tests).
is_update_id() {
	[[ "$1" =~ ^[A-Za-z0-9-]{8,64}$ ]]
}

# Paths written into systemd units: no spaces, quotes, % or other specials.
is_safe_unit_path() {
	[[ "$1" =~ ^/[A-Za-z0-9._/-]+$ ]]
}

# Quotes a value for the small JSON files below. Values are checked before they
# get here; this only keeps a stray quote or control character from breaking
# the file.
json_string() {
	local value="$1"

	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	value="$(printf '%s' "$value" | tr -d '\000-\037')"
	printf '"%s"' "$value"
}

# First string value of a key in a small JSON text. Never evaluated: callers
# check the value against a strict pattern before using it.
json_text_field() {
	local text="$1"
	local key="$2"

	printf '%s' "$text" \
		| grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
		| head -n1 \
		| sed 's/^.*:[[:space:]]*"\(.*\)"$/\1/' || true
}

# Image tag this install runs now: NEXTPRESS_VERSION in .env (compose falls
# back to latest). Fails for anything that is not a plain tag.
read_installed_image_tag() {
	local env_path="$INSTALL_DIR/.env"
	local tag=""

	if [ -f "$env_path" ]; then
		tag="$(awk -F= '/^NEXTPRESS_VERSION=/{print substr($0, index($0, "=") + 1); exit}' "$env_path" 2>/dev/null || true)"
	fi
	if [ "$tag" = "" ]; then
		tag="latest"
	fi
	if [[ ! "$tag" =~ ^[a-zA-Z0-9._-]+$ ]]; then
		return 1
	fi
	printf '%s\n' "$tag"
}

# Newest official release, asked of GitHub directly: the runner never takes the
# app's word for which version is current.
fetch_latest_release_version() {
	local body tag version

	body="$(curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' "$RELEASE_LATEST_API_URL")" || return 1
	tag="$(json_text_field "$body" "tag_name")"
	version="$(printf '%s' "$tag" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || true)"
	is_release_version "$version" || return 1
	printf '%s\n' "$version"
}

# The shared folder the app writes requests into, and the private folder for
# logs, the lock and scratch files.
prepare_update_dirs() {
	local shared private

	shared="$(update_dir)"
	private="$(update_log_dir)"
	mkdir -p "$shared" "$private" || return 1
	chmod 0755 "$shared" || return 1
	chmod 0700 "$private" || return 1
}

# Moves a finished temp file from the private folder into update/. A rename,
# so the app sees the whole file at once and a planted link is replaced.
publish_update_file() {
	local tmp="$1"
	local name="$2"

	chmod 0644 "$tmp" && mv -f "$tmp" "$(update_dir)/$name"
}

# runner.json: tells the app whether anything on this host acts on requests.
write_update_helper_marker() {
	local enabled="$1"
	local tmp

	[ "$enabled" = "true" ] || enabled="false"
	tmp="$(mktemp "$(update_log_dir)/.runner.XXXXXX")" || return 1
	{
		printf '{\n'
		printf '  "protocol": %s,\n' "$UPDATE_PROTOCOL"
		printf '  "enabled": %s,\n' "$enabled"
		printf '  "helper": "systemd",\n'
		printf '  "installDir": %s,\n' "$(json_string "$INSTALL_DIR")"
		printf '  "cliVersion": %s,\n' "$(json_string "$CLI_VERSION")"
		printf '  "updatedAt": %s\n' "$(json_string "$(utc_now)")"
		printf '}\n'
	} > "$tmp" || { rm -f "$tmp"; return 1; }
	publish_update_file "$tmp" "runner.json"
}

# status.json for the dashboard. The same text is kept as the private
# last-status.json, which is the only copy this runner ever reads back.
write_update_status() {
	local state="$1"
	local code="$2"
	local step="${3:-}"
	local restored="${4:-false}"
	local finished_at=""
	local tmp

	case "$state" in
		done|failed) finished_at="$(utc_now)" ;;
	esac
	[ "$restored" = "true" ] || restored="false"

	tmp="$(mktemp "$(update_log_dir)/.status.XXXXXX")" || return 1
	{
		printf '{\n'
		printf '  "protocol": %s,\n' "$UPDATE_PROTOCOL"
		printf '  "state": %s,\n' "$(json_string "$state")"
		printf '  "code": %s,\n' "$(json_string "$code")"
		printf '  "step": %s,\n' "$(json_string "$step")"
		printf '  "requestId": %s,\n' "$(json_string "$UPDATE_RUN_REQUEST_ID")"
		printf '  "version": %s,\n' "$(json_string "$UPDATE_RUN_VERSION")"
		printf '  "fromTag": %s,\n' "$(json_string "$UPDATE_RUN_FROM_TAG")"
		printf '  "startedAt": %s,\n' "$(json_string "$UPDATE_RUN_STARTED_AT")"
		printf '  "finishedAt": %s,\n' "$(json_string "$finished_at")"
		printf '  "logPath": %s,\n' "$(json_string "$UPDATE_RUN_LOG_PATH")"
		printf '  "siteRestored": %s\n' "$restored"
		printf '}\n'
	} > "$tmp" || { rm -f "$tmp"; return 1; }
	cp -f "$tmp" "$(update_log_dir)/last-status.json" || true
	publish_update_file "$tmp" "status.json"
}

log_update() {
	if [ "$UPDATE_RUN_LOG_PATH" != "" ]; then
		printf '%s %s\n' "$(utc_now)" "$*" >> "$UPDATE_RUN_LOG_PATH" 2>/dev/null || true
	fi
	info "$*"
}

finish_update_run() {
	local state="$1"
	local code="$2"
	local restored="${3:-false}"

	UPDATE_RUN_FINISHED="true"
	write_update_status "$state" "$code" "" "$restored" || warn "Could not write the update status for the dashboard."
	log_update "Update $state ($code)."
}

# Safety net: if the runner stops unexpectedly mid-run, tell the dashboard
# instead of leaving it on "running" forever.
on_update_runner_exit() {
	local exit_code=$?

	if [ "$UPDATE_RUN_FINISHED" != "true" ] && [ "$UPDATE_RUN_STARTED_AT" != "" ]; then
		UPDATE_RUN_FINISHED="true"
		write_update_status failed runner_error "" false || true
		log_update "The update runner stopped unexpectedly (exit $exit_code)."
	fi
	rm -rf "$(update_log_dir)/request.claimed" 2>/dev/null || true
}

# State of an earlier run of the same request (a repeated trigger), from the
# runner's private copy of the last status.
previous_update_state() {
	local request_id="$1"
	local copy text state

	copy="$(update_log_dir)/last-status.json"
	[ -f "$copy" ] || return 0
	text="$(head -c 65536 "$copy" 2>/dev/null || true)"
	[ "$(json_text_field "$text" "requestId")" = "$request_id" ] || return 0
	state="$(json_text_field "$text" "state")"
	case "$state" in
		running|done|failed) printf '%s\n' "$state" ;;
	esac
}

# Download first, while the sites are still online: a failed download changes
# nothing. `nextpress upgrade` then finds the image already here.
pull_release_image() {
	local version="$1"

	if [ "${NEXTPRESS_SKIP_IMAGE_PULL:-}" = "true" ]; then
		info "Skipping image pull because NEXTPRESS_SKIP_IMAGE_PULL=true."
		return 0
	fi
	info "Downloading $(release_image_ref "$version") while the sites stay online..."
	docker_cmd pull "$(release_image_ref "$version")"
}

# The tested upgrade path, run as its own process (it may self-update the
# command and re-exec it).
run_core_upgrade() {
	local version="$1"

	"$UPDATE_CLI_SELF" --install-dir "$INSTALL_DIR" upgrade --version "$(release_image_tag "$version")"
}

# After a failed upgrade: put back the image tag that was running and start it.
# The database stays as it is: the upgrade saves a copy before changing it.
restore_previous_release() {
	local current

	if [ "$UPDATE_RUN_FROM_TAG" = "" ]; then
		warn "The previous version is unknown, so it cannot be put back."
		return 1
	fi
	info "Putting back $UPDATE_RUN_FROM_TAG..."
	current="$(read_installed_image_tag || true)"
	if [ "$current" != "$UPDATE_RUN_FROM_TAG" ]; then
		write_or_update_env "$UPDATE_RUN_FROM_TAG"
	fi
	cd "$INSTALL_DIR" || return 1
	compose up -d || return 1
	wait_for_app_health
}

# Turns the log of a failed run into a code the dashboard explains in plain
# words. Keep in step with CORE_UPDATE_FAILURE_CODES in shared/core-update.
classify_update_failure() {
	local fallback="$1"
	local log="$UPDATE_RUN_LOG_PATH"

	if grep -q "Another NextPress update is already running" "$log" 2>/dev/null; then
		printf '%s\n' "busy"
	elif grep -qiE "Need at least [0-9]+MB free|no space left on device" "$log" 2>/dev/null; then
		printf '%s\n' "low_disk"
	elif grep -q "Schema upgrade expects" "$log" 2>/dev/null; then
		printf '%s\n' "needs_manual_step"
	elif grep -q "Database backup failed" "$log" 2>/dev/null; then
		printf '%s\n' "backup_failed"
	elif grep -q "App health check failed" "$log" 2>/dev/null; then
		printf '%s\n' "health_check_failed"
	elif grep -qiE "manifest unknown|pull access denied|could not resolve host|TLS handshake timeout|Could not fetch compose" "$log" 2>/dev/null; then
		printf '%s\n' "download_failed"
	else
		printf '%s\n' "$fallback"
	fi
}

prune_update_logs() {
	local old

	while IFS= read -r old; do
		[ -n "$old" ] || continue
		rm -f "$old"
	done < <(ls -t "$(update_log_dir)"/update-*.log 2>/dev/null | tail -n +$((UPDATE_LOG_KEEP_COUNT + 1)) || true)
}

# Runs one update the dashboard asked for. Started by the systemd path unit
# whenever update/request.json exists; quiet and quick when there is nothing.
run_update_runner() {
	local shared_dir private_dir request claimed content request_id version requested_by
	local mtime age latest code restored

	shared_dir="$(update_dir)"
	private_dir="$(update_log_dir)"
	request="$shared_dir/request.json"

	if [ ! -e "$request" ] && [ ! -L "$request" ]; then
		return 0
	fi

	prepare_update_dirs || fail "Could not prepare $shared_dir and $private_dir. Check their owner and permissions."
	claimed="$private_dir/request.claimed"
	rm -rf "$claimed"
	# Rename, not copy: whatever sits at request.json (a file, a link, a pipe)
	# moves out of the app's reach before this script looks at it.
	if ! mv -f "$request" "$claimed" 2>/dev/null; then
		if [ -e "$request" ] || [ -L "$request" ]; then
			fail "Could not take the update request from $shared_dir. Check that folder's owner and permissions."
		fi
		return 0
	fi

	UPDATE_RUN_STARTED_AT="$(utc_now)"
	UPDATE_RUN_LOG_PATH="$private_dir/update-$(date -u +%Y%m%d-%H%M%S).log"
	UPDATE_RUN_FROM_TAG="$(read_installed_image_tag || true)"
	trap on_update_runner_exit EXIT
	trap 'exit 143' TERM INT HUP
	log_update "Update request received."

	if [ -L "$claimed" ] || [ ! -f "$claimed" ] || [ "$(wc -c < "$claimed")" -gt "$UPDATE_REQUEST_MAX_BYTES" ]; then
		rm -rf "$claimed"
		finish_update_run failed bad_request
		return 0
	fi
	mtime="$(stat -c %Y "$claimed" 2>/dev/null || printf '0')"
	content="$(head -c "$UPDATE_REQUEST_MAX_BYTES" "$claimed")"
	rm -f "$claimed"

	request_id="$(json_text_field "$content" "requestId")"
	version="$(json_text_field "$content" "version")"
	requested_by="$(json_text_field "$content" "requestedBy")"

	if ! is_update_id "$request_id"; then
		finish_update_run failed bad_request
		return 0
	fi
	UPDATE_RUN_REQUEST_ID="$request_id"

	case "$(previous_update_state "$request_id")" in
		done|failed)
			UPDATE_RUN_FINISHED="true"
			log_update "Request $request_id was already handled; nothing to do."
			return 0
			;;
		running)
			finish_update_run failed interrupted
			return 0
			;;
	esac

	if ! is_release_version "$version"; then
		finish_update_run failed bad_request
		return 0
	fi
	UPDATE_RUN_VERSION="$version"
	is_update_id "$requested_by" || requested_by="unknown"
	log_update "Requested by user $requested_by: ${UPDATE_RUN_FROM_TAG:-unknown} -> $(release_image_tag "$version")."
	# Show the run at once, so the dashboard never offers a second start while
	# this one is still being checked.
	write_update_status running running waiting || warn "Could not write the update status for the dashboard."

	age=$(( $(date +%s) - mtime ))
	if [ "$age" -gt "$UPDATE_REQUEST_MAX_AGE_SECONDS" ]; then
		finish_update_run failed expired
		return 0
	fi
	if upgrade_lock_busy; then
		finish_update_run failed busy true
		return 0
	fi
	if ! latest="$(fetch_latest_release_version)"; then
		finish_update_run failed release_check_failed
		return 0
	fi
	if [ "$latest" != "$version" ]; then
		log_update "The newest official release is $latest, not $version."
		finish_update_run failed not_latest
		return 0
	fi

	write_update_status running running download || warn "Could not write the update status for the dashboard."
	if ! ( pull_release_image "$version" ) >>"$UPDATE_RUN_LOG_PATH" 2>&1; then
		finish_update_run failed "$(classify_update_failure download_failed)" true
		prune_update_logs
		return 0
	fi

	write_update_status running running install || warn "Could not write the update status for the dashboard."
	if ( run_core_upgrade "$version" ) >>"$UPDATE_RUN_LOG_PATH" 2>&1; then
		finish_update_run done updated
		prune_update_logs
		return 0
	fi

	code="$(classify_update_failure upgrade_failed)"
	restored="false"
	if [ "$code" = "busy" ]; then
		# The other upgrade owns the stack; this one stopped before changing anything.
		restored="true"
	elif ( restore_previous_release ) >>"$UPDATE_RUN_LOG_PATH" 2>&1; then
		restored="true"
	fi
	finish_update_run failed "$code" "$restored"
	prune_update_logs
}

# The default install keeps the plain unit name; any other install dir gets its
# own units, so two installs on one host never share a watcher.
update_unit_name() {
	if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
		printf '%s\n' "nextpress-update"
		return
	fi
	printf 'nextpress-update-%s\n' "$(printf '%s' "$INSTALL_DIR" | cksum | awk '{print $1}')"
}

# Absolute path of the command the service runs: the installed command when
# there is one (self-update keeps it current), else this script.
update_cli_path() {
	local installed

	installed="$(command -v nextpress 2>/dev/null || true)"
	if [ "${installed#/}" != "$installed" ]; then
		printf '%s\n' "$installed"
		return
	fi
	printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd -P)" "$(basename "$0")"
}

render_update_service_unit() {
	local cli="$1"

	cat <<EOF
# Written by nextpress update-helper. Runs "nextpress upgrade" when the admin
# dashboard asks for an update. Turn off: nextpress update-helper off
[Unit]
Description=NextPress update requested from the admin dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=$cli --install-dir $INSTALL_DIR update-runner
EOF
}

render_update_path_unit() {
	local name="$1"

	cat <<EOF
# Written by nextpress update-helper. Starts $name.service when the admin
# dashboard leaves an update request. Turn off: nextpress update-helper off
[Unit]
Description=Watch for NextPress update requests from the admin dashboard

[Path]
PathExists=$(update_dir)/request.json
Unit=$name.service

[Install]
WantedBy=multi-user.target
EOF
}

install_update_units() {
	local unit_dir name cli tmp_dir changed="false"

	unit_dir="$(systemd_unit_dir)"
	name="$(update_unit_name)"
	cli="$(update_cli_path)"
	if ! is_safe_unit_path "$cli"; then
		warn "Cannot use $cli in a system service."
		return 1
	fi

	tmp_dir="$(mktemp -d)" || return 1
	render_update_service_unit "$cli" > "$tmp_dir/service"
	render_update_path_unit "$name" > "$tmp_dir/path"
	if ! cmp -s "$tmp_dir/service" "$unit_dir/$name.service"; then
		install -m 0644 "$tmp_dir/service" "$unit_dir/$name.service" || { rm -rf "$tmp_dir"; return 1; }
		changed="true"
	fi
	if ! cmp -s "$tmp_dir/path" "$unit_dir/$name.path"; then
		install -m 0644 "$tmp_dir/path" "$unit_dir/$name.path" || { rm -rf "$tmp_dir"; return 1; }
		changed="true"
	fi
	rm -rf "$tmp_dir"

	if [ "$changed" = "true" ]; then
		systemctl daemon-reload || return 1
	fi
	systemctl enable --now "$name.path" >/dev/null 2>&1
}

remove_update_units() {
	local unit_dir name

	unit_dir="$(systemd_unit_dir)"
	name="$(update_unit_name)"
	systemctl disable --now "$name.path" >/dev/null 2>&1 || true
	rm -f "$unit_dir/$name.path" "$unit_dir/$name.service"
	systemctl daemon-reload >/dev/null 2>&1 || true
}

# Why this host can't run the update helper; prints nothing when it can.
update_helper_blocker() {
	if ! systemd_available; then
		printf '%s\n' "Updates from the dashboard need systemd on this server. Update with: nextpress upgrade"
	elif ! running_as_root; then
		printf '%s\n' "To turn on updates from the dashboard, run once: sudo nextpress update-helper on"
	elif ! is_safe_unit_path "$INSTALL_DIR"; then
		printf '%s\n' "Updates from the dashboard need an install path of letters, numbers, dots, dashes and slashes only."
	fi
}

install_update_helper() {
	prepare_update_dirs || { warn "Could not prepare $(update_dir)."; return 1; }
	install_update_units || { warn "Could not set up the update service. Check: systemctl status $(update_unit_name).path"; return 1; }
	write_update_helper_marker true || { warn "Could not tell the dashboard that updates are on."; return 1; }
}

# Best effort, never fails the caller: install and upgrade end with this, so
# dashboard updates work without a separate step.
ensure_update_helper() {
	local blocker

	if [ -f "$INSTALL_DIR/$UPDATE_HELPER_OFF_FILE" ]; then
		( prepare_update_dirs && write_update_helper_marker false ) >/dev/null 2>&1 || true
		info "Updates from the dashboard are off on this server (turn on: sudo nextpress update-helper on)."
		return 0
	fi
	blocker="$(update_helper_blocker)"
	if [ "$blocker" != "" ]; then
		info "$blocker"
		return 0
	fi
	if ( install_update_helper ); then
		info "Updates from the admin dashboard are on (turn off: sudo nextpress update-helper off)."
	else
		warn "Updates from the dashboard could not be turned on. Update with: nextpress upgrade"
	fi
	return 0
}

turn_update_helper_on() {
	local blocker

	blocker="$(update_helper_blocker)"
	if [ "$blocker" != "" ]; then
		fail "$blocker"
	fi
	rm -f "$INSTALL_DIR/$UPDATE_HELPER_OFF_FILE" || fail "Could not change $INSTALL_DIR."
	install_update_helper || fail "Updates from the dashboard could not be turned on."
	info "Updates from the admin dashboard are on."
	if [ -f "$INSTALL_DIR/$COMPOSE_FILE" ] && ! grep -q "/app/update" "$INSTALL_DIR/$COMPOSE_FILE"; then
		info "Run nextpress upgrade once so the app can reach the update folder."
	fi
}

turn_update_helper_off() {
	touch "$INSTALL_DIR/$UPDATE_HELPER_OFF_FILE" 2>/dev/null || fail "Could not change $INSTALL_DIR. Re-run with sudo."
	if systemd_available && running_as_root; then
		remove_update_units
	fi
	if [ -d "$(update_dir)" ]; then
		rm -f "$(update_dir)/request.json"
		( prepare_update_dirs && write_update_helper_marker false ) \
			|| warn "Could not tell the dashboard; it may offer updates until the next upgrade."
	fi
	info "Updates from the admin dashboard are off. Update with: nextpress upgrade"
}

print_update_helper_status() {
	local name last text

	name="$(update_unit_name)"
	if [ -f "$INSTALL_DIR/$UPDATE_HELPER_OFF_FILE" ]; then
		info "Updates from the admin dashboard: off (turn on: sudo nextpress update-helper on)"
	elif systemd_available && systemctl is-active --quiet "$name.path" 2>/dev/null; then
		info "Updates from the admin dashboard: on ($name.path watches $(update_dir))"
	else
		info "Updates from the admin dashboard: not set up (turn on: sudo nextpress update-helper on)"
	fi

	last="$(update_log_dir)/last-status.json"
	if [ -r "$last" ]; then
		text="$(head -c 65536 "$last")"
		info "Last update: $(json_text_field "$text" "state") ($(json_text_field "$text" "code")), version $(json_text_field "$text" "version")"
		info "Log: $(json_text_field "$text" "logPath")"
	fi
}

run_update_helper() {
	local action="${1:-status}"

	if [ "$#" -gt 1 ]; then
		fail "Use: nextpress update-helper on|off|status"
	fi
	assert_install_dir_exists
	case "$action" in
		on) turn_update_helper_on ;;
		off) turn_update_helper_off ;;
		status) print_update_helper_status ;;
		*) fail "Use: nextpress update-helper on|off|status" ;;
	esac
}

# Started by the update service, not by people.
run_update_runner_command() {
	if [ "$#" -gt 0 ]; then
		fail "update-runner takes no options; the update service starts it."
	fi
	assert_install_dir_exists
	UPDATE_CLI_SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
	run_update_runner
}

run_reload() {
	assert_install_dir_exists

	info "Reloading Caddy in $INSTALL_DIR..."
	(cd "$INSTALL_DIR" && compose restart caddy)
}

run_restart() {
	assert_install_dir_exists

	info "Restarting all services in $INSTALL_DIR..."
	(cd "$INSTALL_DIR" && compose restart)
}

run_status() {
	assert_install_dir_exists
	(cd "$INSTALL_DIR" && compose ps)
}

run_logs() {
	assert_install_dir_exists
	(cd "$INSTALL_DIR" && compose logs -f "$@")
}

run_uninstall() {
	local image_id
	local image_ids

	parse_uninstall_args "$@"
	assert_install_dir_exists

	if [ -f "$INSTALL_DIR/$COMPOSE_FILE" ]; then
		info "Stopping stack and removing named volumes..."
		(cd "$INSTALL_DIR" && compose down -v --remove-orphans) || warn "Compose down failed; continuing cleanup."
	else
		warn "No $COMPOSE_FILE found; skipping compose down."
	fi

	if systemd_available && running_as_root; then
		info "Removing the dashboard update service (best effort)..."
		remove_update_units
	fi

	info "Removing NextPress images (best effort)..."
	image_ids="$(docker_cmd images -q husseinkizz/nextpress || true)"
	for image_id in $image_ids; do
		docker_cmd rmi -f "$image_id" >/dev/null 2>&1 || true
	done

	info "Removing install directory: $INSTALL_DIR"
	if ! rm -rf "$INSTALL_DIR" 2>/dev/null; then
		if command_exists sudo; then
			sudo rm -rf "$INSTALL_DIR"
		else
			fail "Could not remove install directory: $INSTALL_DIR. Re-run with sudo or remove it manually."
		fi
	fi

	if [ -d "$INSTALL_DIR" ]; then
		fail "Could not remove install directory: $INSTALL_DIR. Re-run with sudo or remove it manually."
	fi

	info ""
	info "Uninstall finished."
}

main() {
	parse_global_args "$@"
	resolve_install_dir "$INSTALL_DIR"

	local command="${POSITIONALS[0]:-help}"
	local sub_args=("${POSITIONALS[@]:1}")

	case "$command" in
		help|--help|-h)
			print_help
			;;
		version|--version|-v)
			printf '%s\n' "$CLI_VERSION"
			;;
		install)
			run_install "${sub_args[@]}"
			;;
		upgrade)
			run_upgrade "${sub_args[@]}"
			;;
		reload)
			run_reload
			;;
		restart)
			run_restart
			;;
		status)
			run_status
			;;
		logs)
			run_logs "${sub_args[@]}"
			;;
		export)
			run_export "${sub_args[@]}"
			;;
		import)
			run_import "${sub_args[@]}"
			;;
		reset)
			run_reset "${sub_args[@]}"
			;;
		reset-password)
			run_reset_password "${sub_args[@]}"
			;;
		update-helper)
			run_update_helper "${sub_args[@]}"
			;;
		update-runner)
			run_update_runner_command "${sub_args[@]}"
			;;
		uninstall)
			run_uninstall "${sub_args[@]}"
			;;
		*)
			printf '%s\n\n' "Unknown command: $command" >&2
			print_help
			exit 1
			;;
	esac
}

# main runs inside one block that bash reads whole before running it, and that
# ends with exit. `nextpress upgrade` can replace this file in place
# (self-update) while another nextpress process, such as the update runner, is
# still running it; bash must never read on from its old position in the new
# file. Sourcing the file (tests) only defines the functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
	exit "$?"
fi
