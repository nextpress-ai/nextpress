{
  "name": "@nextpress-org/mcp",
  "version": "0.2.0",
  "description": "MCP server for NextPress — manage pages, posts, media, and blocks from Cursor, Claude, and other agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "nextpress-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextpress-org/nextpress.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/nextpress-org/nextpress/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/nextpress-org/nextpress/issues"
  },
  "keywords": [
    "nextpress",
    "mcp",
    "model-context-protocol",
    "cms",
    "cursor",
    "claude",
    "ai"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "@nextpress-org/sdk": "workspace:^0.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.6.3",
    "vitest": "^3.2.4"
  }
}
